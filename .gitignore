# ============================
# DisasterLens — root .gitignore
# Covers: Python/FastAPI backend + Vite/React frontend + Windows
# ============================

# ----- Environment & secrets -----
.env
.env.*
!.env.example
*.pem
*.key

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.python-version
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
*.egg

# ----- Node / Vite frontend -----
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ----- Backend runtime data / caches (regenerable) -----
backend/cache/
backend/__pycache__/
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal
*.wal
*.shm

# Raw one-off OSM fetch output (regenerate via scratch_fetch.py + process_osm.py)
backend/real_osm_mumbai.json

# NOTE: backend/processed_mumbai_osm.json is intentionally TRACKED
# (small ~1MB seed validation dataset loaded by geodata/cached_scenarios.py)

# ----- Geo / large data artifacts -----
*.tif
*.tiff
*.geotiff
*.gdb/
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.qpj

# ----- Logs & temp -----
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# ----- OS -----
.DS_Store
Thumbs.db
Desktop.ini

# ----- Editors -----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
