# Frontend environment variables
#
# VITE_API_BASE: base URL for the DisasterLens backend API.
# - Local Dev (default): relative `/api` (proxied by Vite dev server to localhost:8000)
#   VITE_API_BASE=http://localhost:8000/api
#
# - Vercel Production Deployment:
#   Set this environment variable in the Vercel Project Dashboard:
#   (Project Settings -> Environment Variables)
#   VITE_API_BASE=https://your-backend-service.onrender.com/api

